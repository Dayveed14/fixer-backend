{
  "name": "fixer_backend",
  "version": "1.0.0",
  "description": "Fixer API: bookings, pickups and repairs, payments (Paystack), FixBot diagnosis.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:all": "npm test && npm run test:integration",
    "test:coverage": "jest --coverage --collectCoverageFrom=\"controllers/**/*.js\" --collectCoverageFrom=\"routes/**/*.js\" --collectCoverageFrom=\"middleware/auth.js\"",
    "db:setup": "node scripts/db-setup.js",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:verify-restore": "bash scripts/verify-restore.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.11.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "groq-sdk": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "meshcentral": "^1.2.4",
    "multer": "^2.2.0",
    "mysql2": "^3.22.6",
    "nodemailer": "^9.0.3",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
