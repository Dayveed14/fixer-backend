# Copy to .env for local development. On Render, set these in the
# service's Environment tab. Never commit a real .env.

# ---- Required (the server refuses to start in production without these)
NODE_ENV=production
PORT=4000
JWT_SECRET=use-a-long-random-string-of-at-least-32-characters
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
RESEND_API_KEY=

# ---- Database connection
# TLS is on by default. Only set DB_SSL=false for a local/CI database.
# DB_SSL=true
# DB_POOL_SIZE=10

# ---- Recommended (features degrade without them)
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Receives admin emails (new shipments, approvals) and critical alerts.
ADMIN_EMAIL=
# Where the public contact form is delivered.
CONTACT_EMAIL_TO=

# ---- Monitoring & alerts (optional; alerts are always logged)
# A Slack/Discord-style incoming webhook; receives {"text": "..."}.
# ALERT_WEBHOOK_URL=
# ALERT_COOLDOWN_MINUTES=30
# ALERT_5XX_THRESHOLD=10              # server errors within 5 minutes
# ALERT_PAYMENT_FAILURE_THRESHOLD=5   # failed/mismatched payments per hour

# ---- Remote desktop: MeshCentral (only needed for remote_desktop bookings)
# MESHCENTRAL_URL=wss://mesh.example.com
# MESHCENTRAL_LOGIN_USER=
# MESHCENTRAL_LOGIN_PASS=
# MESHCENTRAL_DEVICE_GROUP_ID=

# ---- Video calls: Google Meet links (optional)
# Without these, video bookings get a free Jitsi Meet room instead.
# Needs a Google Workspace service account with domain-wide delegation
# for the calendar.events scope, acting as GOOGLE_IMPERSONATE_USER.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_CALENDAR_ID=support@yourdomain.com
# GOOGLE_IMPERSONATE_USER=support@yourdomain.com

# ---- Optional tuning (defaults shown)
# PAYSTACK_TIMEOUT_MS=10000
# JSON_BODY_LIMIT=100kb
# FixBot AI fallback
# AI_TIMEOUT_MS=20000
# AI_DAILY_LIMIT_PER_CALLER=10
# AI_DAILY_LIMIT_GLOBAL=300
# Rate limits (requests per 15 minutes unless noted)
# DIAGNOSIS_RATE_LIMIT_GUEST=8
# DIAGNOSIS_RATE_LIMIT_USER=20
# PAYMENT_RATE_LIMIT=20
# LOGIN_RATE_LIMIT=10
# PASSWORD_RATE_LIMIT=5
# REGISTER_RATE_LIMIT=10   # per hour
# CONTACT_RATE_LIMIT=5

# ---- Unused: services/ai.js (Groq) isn't wired to any route.
# GROQ_API_KEY=
